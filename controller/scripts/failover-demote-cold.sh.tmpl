#!/usr/bin/env bash
set -euo pipefail
echo "=== Pillar: Demoting recovered ex-primary (crash failover cleanup) ==="

# Flip the symlink FIRST: any validator (re)start from this point boots with
# the unstaked identity, so a systemd auto-restart cannot double-vote.
ln -sfn {{unstaked_identity_path}} {{symlink_path}}

if systemctl is-active --quiet {{service_name}}; then
  {{binary_path}} -l {{ledger_path}} set-identity {{unstaked_identity_path}} \
    || sudo systemctl restart {{service_name}}
fi
echo "=== Cold demote complete ==="
