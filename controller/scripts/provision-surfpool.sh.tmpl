#!/usr/bin/env bash
set -euo pipefail
echo "=== Pillar: Provisioning Surfpool {{version}} on {{cluster}} ==="

# Surfpool is a local Solana test validator / mainnet-fork simulator (drop-in for
# solana-test-validator). It serves standard Solana JSON-RPC locally and does NOT need
# gossip/turbine/snapshot sync, so it comes up instantly healthy — ideal for testing/demos.

CURRENT_VERSION=$({{binary_path}} --version 2>/dev/null | awk '{print $2}' || true)
if [ ! -x "{{binary_path}}" ] || [ "$CURRENT_VERSION" != "{{version}}" ]; then
  echo "Installing surfpool {{version}}..."
  STAGING=$(mktemp -d)
  curl -sSfL -o "$STAGING/surfpool.tar.gz" "https://github.com/solana-foundation/surfpool/releases/download/v{{version}}/surfpool-linux-x64.tar.gz"
  tar -xzf "$STAGING/surfpool.tar.gz" -C "$STAGING"
  sudo install -m 755 "$STAGING/surfpool" {{binary_path}}
  rm -rf "$STAGING"
fi
echo "surfpool ready at {{binary_path}}"

{{data_dirs_section}}

# Stop existing service if running
sudo systemctl stop {{old_service_name}} 2>/dev/null || true
sudo systemctl disable {{old_service_name}} 2>/dev/null || true

# Working directory for surfpool state
sudo install -d -o sol -g sol /home/sol/surfpool

# Write systemd unit
sudo tee /etc/systemd/system/{{service_name}}.service > /dev/null <<'UNIT'
[Unit]
Description=Surfpool (local Solana test validator)
After=network-online.target
Wants=network-online.target
{{start_limit_line}}

[Service]
Type=simple
User=sol
WorkingDirectory=/home/sol/surfpool
ExecStart={{exec_start}}
Restart=on-failure
RestartSec={{restart_sec}}
LimitNOFILE=1000000
{{log_rate_limit_line}}
{{environment_lines}}

[Install]
WantedBy=multi-user.target
UNIT

sudo systemctl daemon-reload
sudo systemctl enable --now {{service_name}}
sleep 20
STATE=$(systemctl is-active {{service_name}} || true)
RESTARTS=$(systemctl show {{service_name}} -p NRestarts --value)
if [ "$STATE" = "failed" ] || [ "${RESTARTS:-0}" -ge 2 ]; then
  echo "ERROR: {{service_name}} is not running cleanly after start (state=$STATE, restarts=$RESTARTS)" >&2
  systemctl status {{service_name}} --no-pager -l 2>&1 | tail -15 >&2 || true
  exit 1
fi
echo "Service {{service_name}} started"

# Update agent config (client/cluster/service + reference RPC = surfpool's own local RPC)
CONFIG="${PILLAR_AGENT_CONFIG:-/etc/pillar/agent.yaml}"
{{agent_config_sed_commands}}

echo "=== Provision complete ==="

# Restart agent for config reload
(sleep 3 && sudo systemctl restart pillar-agent) >/dev/null 2>&1 &
