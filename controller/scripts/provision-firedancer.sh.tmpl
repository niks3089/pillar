#!/usr/bin/env bash
set -euo pipefail
echo "=== Pillar: Provisioning Firedancer {{version}} on {{cluster}} ==="

{{fdctl_install_section}}

{{data_dirs_section}}

# Stop existing service if running
sudo systemctl stop {{old_service_name}} 2>/dev/null || true

# Write Firedancer TOML config
sudo mkdir -p /etc/pillar
sudo tee /etc/pillar/validator.toml > /dev/null <<'TOML'
{{firedancer_toml}}
TOML
echo "Wrote /etc/pillar/validator.toml"

# Initialize the runtime environment. Stages depend on the net provider: the socket
# provider needs only hugetlbfs+sysctl; xdp needs all stages (incl. NIC/AF_XDP setup).
# Non-fatal + time-bounded so a stuck stage can't wedge provisioning.
echo "Running fdctl configure init {{configure_stages}}..."
if ! sudo timeout 180 {{binary_path}} configure init {{configure_stages}} --config /etc/pillar/validator.toml; then
  echo "WARNING: 'fdctl configure init' failed — hugepages may be unavailable, or (xdp" >&2
  echo "         provider) the NIC/driver may not support AF_XDP. Use net_provider='socket'" >&2
  echo "         on hosts without AF_XDP. Firedancer cannot run until this is resolved." >&2
fi

# Write systemd unit
sudo tee /etc/systemd/system/{{service_name}}.service > /dev/null <<'UNIT'
[Unit]
Description=Solana Validator (firedancer)
After=network.target
{{start_limit_line}}

# NOTE: fdctl must start as root (it sets up its PID namespace / privileged tiles, then
# drops to the `user` configured in the TOML — "sol"). Unlike agave/jito, this unit does
# NOT set User=sol.
[Service]
Type=simple
ExecStart={{exec_start}}
Restart=on-failure
RestartSec={{restart_sec}}
LimitNOFILE=1024000
LimitMEMLOCK=infinity
{{log_rate_limit_line}}
{{environment_lines}}

[Install]
WantedBy=multi-user.target
UNIT

sudo systemctl daemon-reload
sudo systemctl enable --now {{service_name}}
echo "Service {{service_name}} started"

# Update agent config
CONFIG="${PILLAR_AGENT_CONFIG:-/etc/pillar/agent.yaml}"
{{agent_config_sed_commands}}

echo "=== Provision complete ==="

# Restart agent for config reload (deferred so script result can be reported)
(sleep 3 && sudo systemctl restart pillar-agent) >/dev/null 2>&1 &
