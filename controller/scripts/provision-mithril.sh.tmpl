#!/usr/bin/env bash
set -euo pipefail
echo "=== Pillar: Provisioning Mithril {{version}} on {{cluster}} ==="

DOWNLOAD_URL="{{download_url}}"
STAGING="/tmp/pillar-staging"
rm -rf "$STAGING"

if [ -x "{{binary_path}}" ]; then
  CURRENT=$({{binary_path}} --version 2>/dev/null || {{binary_path}} version 2>/dev/null || true)
  CURRENT=$(echo "$CURRENT" | grep -oP '\d+\.\d+\.\d+(-[a-zA-Z0-9.]+)?' | head -1 || true)
  if [ "$CURRENT" = "{{version}}" ]; then
    echo "Binary {{binary_path}} already at v{{version}}, skipping install"
  else
    echo "Binary exists but version $CURRENT != {{version}}, will reinstall"
    CURRENT=""
  fi
fi

if [ -z "${CURRENT:-}" ]; then
  if [ -n "$DOWNLOAD_URL" ]; then
    mkdir -p "$STAGING"
    echo "Downloading from $DOWNLOAD_URL..."
    curl -sSL -o "$STAGING/download" "$DOWNLOAD_URL"
    SHA="{{sha256}}"
    if [ -n "$SHA" ]; then
      echo "$SHA  $STAGING/download" | sha256sum -c
      echo "SHA256 verified"
    fi
    if file "$STAGING/download" | grep -q "bzip2\|gzip\|tar"; then
      mkdir -p "$STAGING/extract"
      tar -xf "$STAGING/download" -C "$STAGING/extract"
      BINARY=$(find "$STAGING/extract" \( -name "mithril" -o -name "mithril-validator" \) -type f | head -1)
      [ -z "$BINARY" ] && { echo "ERROR: mithril binary not found in tarball" >&2; exit 1; }
      sudo install -m 755 "$BINARY" {{binary_path}}
    else
      sudo install -m 755 "$STAGING/download" {{binary_path}}
    fi
  else
    echo "No download_url provided, building Mithril v{{version}} from source..."
    mkdir -p "$STAGING"
    BUILD_DIR="/tmp/mithril-build"
    rm -rf "$BUILD_DIR"

    if ! dpkg -s build-essential >/dev/null 2>&1; then
      sudo apt-get update -qq
      sudo apt-get install -y -qq build-essential clang cmake gcc make pkg-config
    fi

    GO_VERSION=1.26.4
    case "$(uname -m)" in
      x86_64) GOARCH=amd64 ;;
      aarch64|arm64) GOARCH=arm64 ;;
      *) echo "ERROR: unsupported arch $(uname -m)" >&2; exit 1 ;;
    esac
    GO=""
    for cand in /usr/local/go/bin/go "$(command -v go 2>/dev/null || true)" "$HOME/.pillar-go/go/bin/go"; do
      if [ -n "$cand" ] && "$cand" version 2>/dev/null | grep -q "go$GO_VERSION"; then
        GO="$cand"; break
      fi
    done
    if [ -z "$GO" ]; then
      echo "Installing Go $GO_VERSION under \$HOME (no sudo)..."
      rm -rf "$HOME/.pillar-go" && mkdir -p "$HOME/.pillar-go"
      curl -sSL -o "$STAGING/go.tar.gz" "https://go.dev/dl/go${GO_VERSION}.linux-${GOARCH}.tar.gz"
      tar -C "$HOME/.pillar-go" -xzf "$STAGING/go.tar.gz"
      GO="$HOME/.pillar-go/go/bin/go"
    fi
    export PATH="$(dirname "$GO"):$PATH"
    export GOPATH="$HOME/.pillar-go/path"

    git clone --depth 1 --branch v{{version}} https://github.com/Overclock-Validator/mithril.git "$BUILD_DIR"
    cd "$BUILD_DIR"
    echo "Building mithril..."
    "$GO" build -ldflags "-s -w -X github.com/Overclock-Validator/mithril/pkg/version.Version=v{{version}}" -o mithril ./cmd/mithril
    [ -x "$BUILD_DIR/mithril" ] || { echo "ERROR: mithril not found after build" >&2; exit 1; }
    sudo install -m 755 "$BUILD_DIR/mithril" {{binary_path}}
    cd /
    rm -rf "$BUILD_DIR"
    echo "Built and installed mithril v{{version}}"
  fi
fi
echo "Binary ready at {{binary_path}}"

{{data_dirs_section}}

# Stop existing service if running
sudo systemctl stop {{old_service_name}} 2>/dev/null || true
sudo systemctl disable {{old_service_name}} 2>/dev/null || true

# Write Mithril config
sudo mkdir -p /etc/pillar
sudo tee /etc/pillar/validator.toml > /dev/null <<'TOML'
{{mithril_toml}}
TOML
echo "Wrote /etc/pillar/validator.toml"

# Write systemd unit
sudo tee /etc/systemd/system/{{service_name}}.service > /dev/null <<'UNIT'
[Unit]
Description=Solana Validator (mithril)
After=network.target
{{start_limit_line}}

[Service]
Type=simple
User=sol
ExecStart={{exec_start}}
Restart=on-failure
RestartSec={{restart_sec}}
LimitNOFILE=1000000
LimitMEMLOCK=infinity
{{log_rate_limit_line}}
{{environment_lines}}

[Install]
WantedBy=multi-user.target
UNIT

sudo systemctl daemon-reload
sudo systemctl enable --now {{service_name}}
sleep 20
STATE=$(systemctl is-active {{service_name}} || true)
RESTARTS=$(systemctl show {{service_name}} -p NRestarts --value)
if [ "$STATE" = "failed" ] || [ "${RESTARTS:-0}" -ge 2 ]; then
  echo "ERROR: {{service_name}} is not running cleanly after start (state=$STATE, restarts=$RESTARTS)" >&2
  systemctl status {{service_name}} --no-pager -l 2>&1 | tail -15 >&2 || true
  exit 1
fi
echo "Service {{service_name}} started"

# Update agent config
CONFIG="${PILLAR_AGENT_CONFIG:-/etc/pillar/agent.yaml}"
{{agent_config_sed_commands}}

rm -rf "$STAGING"
echo "=== Provision complete ==="

# Restart agent for config reload (deferred so script result can be reported)
(sleep 3 && sudo systemctl restart pillar-agent) >/dev/null 2>&1 &
